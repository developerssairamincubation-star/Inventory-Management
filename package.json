{
  "name": "inventory-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4000",
    "build": "next build",
    "start": "next start -p 4000",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate": "flyway -configFiles=db/conf/flyway.conf -locations=filesystem:db/migrations migrate",
    "db:migrate:test": "flyway -configFiles=db/conf/flyway.conf -url=$FLYWAY_URL_TEST -locations=filesystem:db/migrations migrate",
    "db:seed": "flyway -configFiles=db/conf/flyway.conf -locations=filesystem:db/seed migrate",
    "db:info": "flyway -configFiles=db/conf/flyway.conf info"
  },
  "dependencies": {
    "@google/genai": "^2.17.1",
    "@sentry/nextjs": "^10.70.0",
    "@tanstack/react-query": "^5.101.4",
    "@types/bcryptjs": "^2.4.6",
    "@vercel/speed-insights": "^2.0.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.8",
    "jsbarcode": "^3.12.3",
    "jspdf": "^4.2.0",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.575.0",
    "next": "16.1.6",
    "nextjs-toploader": "^3.9.17",
    "nodemailer": "^9.0.5",
    "pg": "^8.23.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.7.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
