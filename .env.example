# Copy to .env and fill in. See docker-compose.yml for how the local
# Postgres service consumes these.

# ── Local Postgres (docker-compose: postgres, flyway) ───────────────────────
# If host port 5432 is free on your machine you can drop POSTGRES_HOST_PORT
# and change 5433 back to 5432 below; internal docker-network traffic always
# uses postgres:5432 regardless of this value.
POSTGRES_HOST_PORT=5433
POSTGRES_DB=inventory
POSTGRES_TEST_DB=inventory_test
POSTGRES_USER=inventory_app
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://inventory_app:change-me@localhost:5433/inventory
DATABASE_TEST_URL=postgresql://inventory_app:change-me@localhost:5433/inventory_test
FLYWAY_URL=jdbc:postgresql://localhost:5433/inventory
FLYWAY_USER=inventory_app
FLYWAY_PASSWORD=change-me

# ── Cloudinary (src/lib/cloudinary.ts) — used for local dev AND every hosted
# environment alike, one account, scoped by folder. Get these three from
# the Cloudinary dashboard (Settings → API Keys).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Root folder uploads live under — keeps this environment's images separate
# from every other one sharing the same Cloudinary account (e.g. "dev" here,
# "production" in Vercel's env vars).
CLOUDINARY_UPLOAD_FOLDER=dev


# ── JWT auth secrets ─────────────────────────────────────────────────────────
# Must be at least 32 characters; the app refuses to sign a token with a
# shorter one rather than silently accepting a weak secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-value
# Optional. Mixed into the refresh-token hash so a leaked database dump alone
# can't be used to look up valid tokens by their SHA-256. Changing it
# invalidates every existing refresh token, forcing all users to sign in again.
JWT_REFRESH_PEPPER=

# ── Rate limiting (src/lib/rateLimit.ts) ────────────────────────────────────
# Optional. Without it the limiter uses an in-process store, which is correct
# on a single self-hosted container but only limits per-instance on a
# multi-instance deployment like Vercel.
REDIS_URL=
# Set when running behind a proxy chain of known depth, so the client IP is
# counted in from the right of X-Forwarded-For instead of trusting the
# leftmost (client-controlled, spoofable) entry. 1 = one trusted proxy.
TRUSTED_PROXY_DEPTH=

# ── Scheduled maintenance ───────────────────────────────────────────────────
# Shared secret for POST /api/maintenance/prune-sessions, which deletes
# expired/revoked session rows. Point a scheduler at it daily. Unset means the
# endpoint 404s, so it is inert until you configure it.
CRON_SECRET=

# ── Logging / database tuning ───────────────────────────────────────────────
# debug | info | warn | error. Defaults to info in production, debug elsewhere.
LOG_LEVEL=
PGPOOL_MAX=10
PG_STATEMENT_TIMEOUT_MS=15000
PG_QUERY_TIMEOUT_MS=15000

# ── Gemini invoice parsing (src/app/api/invoices/parse-pdf/route.ts) ────────
# Leave unset in local/dev if you don't have a key yet — the route returns a
# clear 501 rather than crashing the build or blocking other invoice features.
GEMINI_API_KEY=

# --- Sentry ---
# Error/performance monitoring. The DSN itself is a public key and is hard-coded
# in sentry.server.config.ts / sentry.edge.config.ts / src/instrumentation-client.ts,
# so nothing below is required for events to be reported.
#
# SENTRY_AUTH_TOKEN is only used at BUILD time, to upload source maps so stack
# traces in Sentry point at real source lines instead of minified bundle output.
# It lives in .env.sentry-build-plugin locally (gitignored) and MUST also be set
# as a build environment variable in Vercel/CI, or production stack traces stay
# unreadable.
SENTRY_AUTH_TOKEN=
# Labels events in the Sentry UI. Leave unset on Vercel — the SDK already
# derives "vercel-production" / "vercel-preview" from VERCEL_ENV, which is more
# useful than anything set here. Falls back to NODE_ENV elsewhere.
SENTRY_ENVIRONMENT=
# Set to 1 to enable GET /api/sentry-check, which throws a test event on demand.
# Leave unset everywhere except when verifying the integration on a deployment
# (local dev never sends to Sentry — see `enabled` in the sentry.*.config.ts).
SENTRY_TEST_ROUTE=
