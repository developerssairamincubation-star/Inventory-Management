# Copy to .env and fill in. See docker-compose.yml for how the local
# Postgres/MinIO/Mailpit services consume these.

# ── Local Postgres (docker-compose: postgres, flyway) ───────────────────────
# If host port 5432 is free on your machine you can drop POSTGRES_HOST_PORT
# and change 5433 back to 5432 below; internal docker-network traffic always
# uses postgres:5432 regardless of this value.
POSTGRES_HOST_PORT=5433
POSTGRES_DB=inventory
POSTGRES_TEST_DB=inventory_test
POSTGRES_USER=inventory_app
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://inventory_app:change-me@localhost:5433/inventory
DATABASE_TEST_URL=postgresql://inventory_app:change-me@localhost:5433/inventory_test
FLYWAY_URL=jdbc:postgresql://localhost:5433/inventory
FLYWAY_USER=inventory_app
FLYWAY_PASSWORD=change-me

# ── Local MinIO (docker-compose: minio, minio-init) ─────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me
MINIO_BUCKET_NAME=inventory-assets

# ── Object storage client config (src/lib/s3.ts, AWS SDK v3 pointed at MinIO) ──
# Host-side (npm run dev) values — should mirror the MINIO_* values above.
# The dockerized `app` service overrides AWS_S3_ENDPOINT to http://minio:9000
# in docker-compose.yml since container-network traffic can't reach the
# host's localhost.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=change-me
AWS_S3_BUCKET_NAME=inventory-assets
AWS_S3_ENDPOINT=http://localhost:9000

# ── Local Mailpit SMTP catcher (password-reset email) ───────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025

# ── JWT auth secrets ─────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-to-a-long-random-value
JWT_REFRESH_PEPPER=change-me-to-a-long-random-value

# ── Legacy (removed in Phase 5 once the JWT/Postgres/MinIO cutover lands) ──
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
